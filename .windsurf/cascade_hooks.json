{
  "hooks": {
    "post_write_code": {
      "command": "prettier --write ${file_path} 2>/dev/null || echo 'Prettier not available'",
      "description": "Auto-format code after edits",
      "enabled": true
    },
    "pre_run_command": {
      "command": "bash -c 'if [[ \"${command}\" =~ ^(rm|supabase\\ db\\ reset|supabase\\ db\\ push\\ --force|npm\\ run\\ build\\ --force) ]]; then echo \"⚠️  Dangerous command detected: ${command}\"; exit 1; fi'",
      "description": "Block dangerous commands",
      "enabled": true
    },
    "post_run_command": {
      "command": "echo \"[$(date)] Command executed: ${command}\" >> .windsurf/command_log.txt",
      "description": "Log all executed commands",
      "enabled": false
    },
    "pre_mcp_tool_use": {
      "command": "echo \"[$(date)] MCP Tool: ${tool_name}\" >> .windsurf/mcp_log.txt",
      "description": "Log MCP tool usage",
      "enabled": false
    }
  },
  "notes": [
    "Hooks run in the project root directory",
    "Available variables: ${file_path}, ${command}, ${tool_name}",
    "Exit code 0 = continue, non-zero = abort",
    "Enable/disable individual hooks with 'enabled' flag",
    "Logs are written to .windsurf/ directory (add to .gitignore)"
  ]
}
