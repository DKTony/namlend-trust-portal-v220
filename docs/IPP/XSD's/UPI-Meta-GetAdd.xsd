<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:upi="http://npci.org/upi/schema/" 
 targetNamespace="http://npci.org/upi/schema/" 
 elementFormDefault="unqualified"
 attributeFormDefault="unqualified">
 
<xs:include schemaLocation="UPI-Common.xsd"></xs:include>
	<xs:element name="ReqGetAdd">
		<xs:annotation>
			<xs:documentation>This new API shall be used for checking the availabilty of an ID before creating a new record as well as for fetching status in case of timeout of CREATE/MODIFY/DELETE record.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" />
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="Payer" type="upi:payerType" />
			</xs:sequence>
		</xs:complexType>		
	</xs:element>

	<xs:element name="RespGetAdd">
		<xs:annotation>
			<xs:documentation>This new API shall be used for checking the availabilty of an ID before creating a new record as well as for fetching status in case of timeout of CREATE/MODIFY/DELETE record.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" />
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="Resp" type="upi:respType" />
			</xs:sequence>
		</xs:complexType>		
	</xs:element>
	
</xs:schema>
