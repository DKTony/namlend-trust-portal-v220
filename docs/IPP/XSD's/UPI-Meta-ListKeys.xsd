<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:upi="http://npci.org/upi/schema/" 
 targetNamespace="http://npci.org/upi/schema/" 
 elementFormDefault="unqualified"
 attributeFormDefault="unqualified">
 
<xs:include schemaLocation="UPI-Common.xsd"></xs:include>
	
	<xs:element name="ReqListKeys">
		<xs:annotation>
			<xs:documentation>IPS maintains the list of all public keys for
				encryption. This API allows the IPS Participants to
				request for and cache the
				list of public keys of account providers and
				other entities in the
				IPS eco system . Trusted and certified libraries will be used by
				IPS Participants
				for credential capture
				and PKI public key encryption at capture
				time. These libraries can be
				provided by IPS.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" />
				<xs:element name="Meta">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Tag" maxOccurs="1" minOccurs="0">
								<xs:complexType>
									<xs:attribute name="name" use="required"
										type="upi:metaTagNameType" />
									<xs:attribute type="xs:string" name="value" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="Creds" type="upi:credsType" />
			</xs:sequence>
		</xs:complexType>		
	</xs:element>

	<xs:element name="RespListKeys">
		<xs:annotation>
			<xs:documentation>IPS maintains the list of all public keys for
				encryption. This API allows the IPS Participants to
				request for and cache the
				list of public keys of account providers and
				other entities in the
				IPS eco system . Trusted and certified libraries will be used by
				IPS Participants
				for credential capture
				and PKI public key encryption at capture
				time. These libraries can be
				provided by IPS.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" />
				<xs:element name="Resp" type="upi:respType"/>
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="keyList">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="key" maxOccurs="10000" minOccurs="1">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="keyValue" maxOccurs="1" minOccurs="0" />
									</xs:sequence>
									<xs:attribute type="xs:string" name="code" />
									<xs:attribute type="xs:string" name="owner" />
									<xs:attribute type="xs:string" name="type" />
									<xs:attribute type="xs:string" name="ki" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				
				<xs:element name="keyListSignature" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="signatureValue" minOccurs="1" />
							</xs:sequence>
							<xs:attribute type="xs:string" name="code" />
							<xs:attribute type="xs:string" name="owner" />
							<xs:attribute type="xs:string" name="type" />
				    </xs:complexType>
			  	</xs:element>
			  	<xs:element name="paramListSignature" minOccurs="0">
				    <xs:complexType>
							<xs:sequence>
								<xs:element name="signatureValue" minOccurs="1" />
							</xs:sequence>
							<xs:attribute type="xs:string" name="code" />
							<xs:attribute type="xs:string" name="owner" />
							<xs:attribute type="xs:string" name="type" />
				    </xs:complexType>
			  	</xs:element>
			</xs:sequence>
		</xs:complexType>		
	</xs:element>
</xs:schema>
