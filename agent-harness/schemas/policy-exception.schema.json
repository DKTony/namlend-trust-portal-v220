{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://namlend.example/agent-harness/v1/policy-exception.schema.json",
  "title": "NamLend Policy Exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "category", "evidence", "owner", "scope", "expiresAt", "gapId"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^EXCEPTION-[A-Z0-9-]+$" },
    "category": { "enum": ["critical-tool-only", "high-tool-only", "non-safety-debt"] },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owner": { "type": "string", "minLength": 3 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "gapId": { "type": "string", "pattern": "^GAP-" },
    "rationale": { "type": "string", "minLength": 10 }
  }
}
