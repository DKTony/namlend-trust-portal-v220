{
  "name": "namlend-trust-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run verify:brand-assets",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "dev:e2e": "VITE_E2E=true vite",
    "test:e2e": "playwright test",
    "test:e2e:staging": "DOTENV_CONFIG_PATH=.env.e2e node -r dotenv/config ./node_modules/@playwright/test/cli.js test",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "ontology:extract": "node scripts/ontology/index.mjs extract",
    "ontology:check": "node scripts/ontology/index.mjs check",
    "ontology:test": "vitest run --config vitest.ontology.config.ts",
    "ontology:impact": "node scripts/ontology/index.mjs impact",
    "ontology:diff": "node scripts/ontology/index.mjs diff",
    "ontology:ingest-results": "node scripts/ontology/index.mjs ingest-results",
    "ontology:prove-results": "node scripts/ontology/index.mjs prove-results",
    "agent:preflight": "node scripts/agent-harness/index.mjs preflight --",
    "agent:context": "node scripts/agent-harness/index.mjs context --",
    "agent:verify": "node scripts/agent-harness/index.mjs verify --",
    "agent:validate-merge": "node scripts/agent-harness/index.mjs validate-merge --",
    "agent:eval": "node scripts/agent-harness/index.mjs eval",
    "agent:policy": "node scripts/agent-harness/index.mjs policy",
    "agent:risk-review": "node scripts/agent-harness/risk-review.mjs",
    "graphify:extract": "node scripts/graphify/index.mjs extract",
    "graphify:query": "node scripts/graphify/index.mjs query --",
    "graphify:check": "node scripts/graphify/index.mjs check",
    "verify:brand-assets": "node scripts/verify-brand-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "docs:lint:active": "markdownlint-cli2 --config .markdownlint.json AGENTS.md CLAUDE.MD CONTRIBUTING.md WORKFLOW.md src/AGENTS.md convex/AGENTS.md e2e/AGENTS.md supabase/AGENTS.md docs/AGENTS.md docs/ARCHITECTURE.md docs/ARCHITECTURAL_REVIEW.md docs/SERVICES.md docs/TECHNICAL_DEBT.md docs/FUNCTIONALITY_MAP.md docs/TESTING.md docs/SECURITY.md docs/adr/*.md",
    "docs:lint": "markdownlint-cli2 --config .markdownlint.json \"docs/**/*.md\"",
    "docs:fix": "markdownlint-cli2 --fix --config .markdownlint.json \"docs/**/*.md\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@sentry/react": "^10.39.0",
    "@supabase/supabase-js": "^2.53.0",
    "@tanstack/react-query": "^5.56.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "convex": "1.43.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.2",
    "embla-carousel-react": "^8.3.0",
    "fast-xml-parser": "5.10.1",
    "i18next": "^25.8.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^16.5.4",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "6.30.4",
    "recharts": "^3.6.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tigerbeetle-node": "^0.16.67",
    "vaul": "^0.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "^10.5.4",
    "convex-test": "^0.0.56",
    "d3-array": "^3.2.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "16.5.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^16.2.7",
    "magic-string": "^0.30.21",
    "markdownlint-cli2": "0.23.2",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "8.67.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
