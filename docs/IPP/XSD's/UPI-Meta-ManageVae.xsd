<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:upi="http://npci.org/upi/schema/" 
 targetNamespace="http://npci.org/upi/schema/" 
 elementFormDefault="unqualified"
 attributeFormDefault="unqualified">
 
<xs:include schemaLocation="UPI-Common.xsd"></xs:include>

	<xs:element name="ReqManageVae">
		<xs:annotation>
			<xs:documentation>IPS offers a mechanism to protect customers from
				attempts to spoof well known
				merchants 
				e-commerce players, telecom players,
				bill
				payment entities, etc. This
				mechanism is an API, where the IPS participants can manage,
				and access
				the common
				collection of verified address entries. IPS, with the help
				of IPS participants,
				will
				define a process to manage these entries.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" minOccurs="1" />
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="VaeList" maxOccurs="50" minOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Vae" maxOccurs="500" minOccurs="1">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="key" type="upi:keyType" />
									</xs:sequence>
									<xs:attribute type="upi:opType" name="op" />
                                    <xs:attribute type="xs:string" name="seqNum" />           
									<xs:attribute type="xs:string" name="name" />
									<xs:attribute type="xs:string" name="addr" />
									<xs:attribute type="xs:string" name="logo" />
									<xs:attribute type="xs:string" name="url" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>		
	</xs:element>

	<xs:element name="RespManageVae">
		<xs:annotation>
			<xs:documentation>IPS offers a mechanism to protect customers from
				attempts to spoof well known
				merchants,
				e-commerce players, telecom players,
				bill
				payment entities, etc. This
				mechanism is an API, where the IPS participants can manage,
				and access
				the common
				collection of verified address entries. IPS, with the help
				of IPS participants,
				will
				define a process to manage these entries.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" minOccurs="1" />
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="Resp">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Ref" maxOccurs="50" minOccurs="0" type="upi:respVaeRef" />
						</xs:sequence>
						<xs:attribute type="xs:string" name="reqMsgId" />
						<xs:attribute type="upi:resultType" name="result" />
						<xs:attribute type="xs:string" name="errCode" />
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>		
	</xs:element>
		
</xs:schema>
