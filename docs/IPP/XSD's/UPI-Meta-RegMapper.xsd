<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:upi="http://npci.org/upi/schema/" 
 targetNamespace="http://npci.org/upi/schema/" 
 elementFormDefault="unqualified"
 attributeFormDefault="unqualified">
 
<xs:include schemaLocation="UPI-Common.xsd"></xs:include>
	<xs:element name="ReqRegMapper">
		<xs:annotation>
			<xs:documentation>This API shall be used by IPS participant for adding and updating the numeric id of the customer in the alias directory as per customer’s consent.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" />
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="Payer" type="upi:payerType" />
			</xs:sequence>
		</xs:complexType>		
	</xs:element>

	<xs:element name="RespRegMapper">
		<xs:annotation>
			<xs:documentation>This API shall be used by IPS participant for adding and updating the numeric id of the customer in the alias directory as per customer’s consent.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" />
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="Resp" type="upi:respType" />
			</xs:sequence>
		</xs:complexType>		
	</xs:element>
	
</xs:schema>
