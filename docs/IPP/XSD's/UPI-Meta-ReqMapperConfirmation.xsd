<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
 xmlns:upi="http://npci.org/upi/schema/" 
 targetNamespace="http://npci.org/upi/schema/" 
 elementFormDefault="unqualified"
 attributeFormDefault="unqualified">
 
<xs:include schemaLocation="UPI-Common.xsd"></xs:include>
	<xs:element name="ReqMapperConfirmation">
		<xs:annotation>
			<xs:documentation>This API shall be used for sending confirmation to old IPS participant while the number shifts to a new IPS participant.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" />
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="TxnConfirmation" type="upi:txnConfirmationType" />
			</xs:sequence>
		</xs:complexType>		
	</xs:element>

	<xs:element name="RespMapperConfirmation">
		<xs:annotation>
			<xs:documentation>This API shall be used for sending confirmation to old IPS participant while the number shifts to a new IPS participant.
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Head" type="upi:headType" />
				<xs:element name="Txn" type="upi:payTrans" />
				<xs:element name="Resp" type="upi:respType" />
			</xs:sequence>
		</xs:complexType>		
	</xs:element>
	
</xs:schema>
