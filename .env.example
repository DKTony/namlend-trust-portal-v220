# Vite environment variables for NamLend
# Copy this file to `.env` (local dev) or set these in your hosting provider (e.g. Netlify)

# Supabase Project URL and Public (anon) Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: Never set the service role key in a Vite client environment.
# Service role is server-only (Edge Functions, serverless, or local scripts not bundled).
# For extremely limited local debugging, you can set VITE_ALLOW_LOCAL_ADMIN=true in `.env`
# and provide SUPABASE_SERVICE_ROLE_KEY via a non-Vite secret mechanism (not recommended).
# The admin client is disabled by default and should remain so.

# Gate any local-only admin client usage (leave as false)
VITE_ALLOW_LOCAL_ADMIN=false

# Gate development-only scripts and utilities
# Set to 'true' only for local development. Keep 'false' in production.
VITE_RUN_DEV_SCRIPTS=false

# Gate debug tools and window exposure (unified dev flag)
# Set to 'true' only for local development debugging. Keep 'false' in production.
# This controls safeExposeWindow() and debugLog() utilities.
VITE_DEBUG_TOOLS=false

# Sentry error tracking (leave empty to disable)
VITE_SENTRY_DSN=

# Enable special behaviors for E2E runs (disables dev auto-tools & window exposures)
# The Playwright webServer will start Vite with VITE_E2E=true via npm run dev:e2e
VITE_E2E=false

# Playwright E2E credentials (server-side only; not exposed to client)
# Used by tests via dotenv. Do not prefix with VITE_. Provide via local .env or CI secrets.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# ============================================
# External Integration API Keys (Edge Functions)
# Set these in Supabase Dashboard > Project Settings > Edge Functions > Secrets
# ============================================

# Africa's Talking SMS Gateway
# AFRICASTALKING_API_KEY=your_api_key_here
# AFRICASTALKING_USERNAME=sandbox  # Use 'sandbox' for testing, your username for production
# SMS_SENDER_ID=NAMLEND

# WhatsApp Business API (Meta Cloud API)
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_ACCESS_TOKEN=your_access_token
# WHATSAPP_BUSINESS_ID=your_business_account_id

# Payment Provider Webhook Secrets (for signature verification)
# PAYTODAY_WEBHOOK_SECRET=your_webhook_secret
# MTC_MOMO_WEBHOOK_SECRET=your_webhook_secret
# TN_MOBILE_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# IPS (Instant Payment Solution) Configuration
# Set these in Supabase Dashboard > Project Settings > Edge Functions > Secrets
# ============================================

# IPS Core Configuration
# IPS_ENABLED=true                    # Enable/disable IPS payments
# IPS_ENVIRONMENT=development         # development | uat | production
# IPS_ORG_ID=NAMLEND                  # Your organization ID from BON

# IPS API Configuration (Production)
# IPS_BASE_URL=https://ips.bon.na/api/v2
# IPS_CLIENT_ID=your_client_id
# IPS_CLIENT_SECRET=your_client_secret

# IPS Certificate Paths (for mTLS)
# IPS_CERTIFICATE_PATH=/secrets/ips-cert.pem
# IPS_PRIVATE_KEY_PATH=/secrets/ips-key.pem

# IPS VPA Addresses
# IPS_COLLECTIONS_VPA=collections@namlend
# IPS_DISBURSEMENTS_VPA=disbursements@namlend

# IPS Timeouts and Limits
# IPS_REQUEST_TIMEOUT_MS=30000        # 30 seconds
# IPS_STATUS_CHECK_INTERVAL_MS=5000   # 5 seconds
# IPS_MAX_STATUS_CHECKS=12            # Max polling attempts
# IPS_MAX_TRANSACTION_AMOUNT=100000   # NAD 100,000

# IPS Webhook Configuration
# IPS_WEBHOOK_SECRET=your_webhook_secret
# IPS_CALLBACK_URL=https://your-domain.com/functions/v1/ips-webhook
