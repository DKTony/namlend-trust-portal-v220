# Dedicated non-production Convex deployment for mutating Playwright E2E.
# Do not point this file at the production URL in convex.json.
VITE_CONVEX_URL=https://<staging-deployment>.convex.cloud
CONVEX_DEPLOYMENT=<staging-deployment-name>
E2E_ALLOW_MUTATING_SEED=true

# Defaults match the deterministic users created by seed:seedTestUsers.
E2E_ADMIN_EMAIL=admin@test.namlend.com
E2E_ADMIN_PASSWORD=Test1234!

# Optional legacy Supabase values. Leave unset unless intentionally running legacy tests.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
